APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Never true in production: debug pages leak configuration and secrets.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Excel photo import: allow photo URLs on localhost/private networks. Local development only, never in production.
REMOTE_IMAGES_ALLOW_PRIVATE_HOSTS=false
# Set to true in production (HTTPS).
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Doit dépasser la durée du plus long job (1800 s), sinon un gros envoi peut partir deux fois.
DB_QUEUE_RETRY_AFTER=1900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Backups
# BACKUP_MYSQLDUMP_PATH=   # optionnel — détection auto (Laragon local ; mariadb-dump / mysqldump en prod)
BACKUP_DISK=backups
BACKUP_RETENTION_COUNT=14
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_DISK=backup_remote

# Contrats — identité de l'organisme signataire (valeurs par défaut dans config/contracts.php)
# CONTRACTS_ORG_NAME="SIMPLON BURKINA FASO"
# CONTRACTS_ORG_ADDRESS="Villa Simplon, quartier Somgandé, secteur 24, lot 21, parcelle 06, section LA, Ouagadougou"
# CONTRACTS_ORG_RCCM=BF-OUA-01-2023-B17-06061
# CONTRACTS_ORG_IFU=00202814A
# CONTRACTS_ORG_PHONE="+226 66 81 71 71"
# CONTRACTS_ORG_EMAIL=simplon.burkina@simplon.co
# CONTRACTS_ORG_REPRESENTATIVE="Monsieur BAGRE Dominique"
# CONTRACTS_ORG_REPRESENTATIVE_TITLE="Représentant pays"

# WhatsApp microservice (whatsapp-web.js)
WWEBJS_URL=http://127.0.0.1:3001

VITE_APP_NAME="${APP_NAME}"
